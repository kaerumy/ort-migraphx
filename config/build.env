# =============================================================================
# ort-migraphx — build configuration (single source of truth)
#
# Every stage script, the assembler and the packager source this file.
# All values can be overridden from the environment, e.g.:
#
#   make build                          # defaults
#   JOBS=16 make build                  # override parallelism
#   GPU_TARGETS="gfx1201 gfx1202" make build
#
# Bumping the stack (newer ROCm / ORT / MIGraphX): edit the "Version pins"
# section below. See README.md ("Bumping versions", "Adding a GPU target").
# =============================================================================

set -a

# --- 1. Target ----------------------------------------------------------------

# Space-separated list of AMD GPU targets (gfx arch names) to build for.
# Each target adds amdrocm-dnn*/amdrocm-blas* <target> packages to the deb
# Depends and is reflected in the package name.
: "${GPU_TARGETS:=gfx1201}"

# Debian package name (default: derived from the target list,
# e.g. "gfx1201 gfx1202" -> ort-migraphx-gfx1201-gfx1202).
# A distinct name per target set keeps per-GPU installs side by side
# (no file clashes under /usr/lib).
: "${PKG_NAME:=ort-migraphx-$(echo "$GPU_TARGETS" | tr ' ' '-')}"

# --- 2. ROCm (AMD TheRock) ------------------------------------------------------

# TheRock ROCm release to build against. Used to derive
#   * the SDK layout dir $ROCM_HOME/core-<ver> (RPATH registration)
#   * the amdrocm-* package names in the deb Depends
: "${ROCM_VERSION:=10.1}"
: "${ROCM_HOME:=/opt/rocm}"

# TheRock installs the runtime under $ROCM_HOME/core-<ROCM_VERSION>/lib and
# exposes it through versioned symlinks at $ROCM_HOME/lib. Both dirs are
# embedded in the staged libraries' RPATH so the stack resolves ROCm even
# with zero ldconfig registration on the target.
ROCM_CORE_LIBDIR="$ROCM_HOME/core-$ROCM_VERSION/lib"
ROCM_LIBDIR="$ROCM_HOME/lib"

# --- 3. Version pins ---------------------------------------------------------------
# The MIGraphX / CK / rocMLIR pins follow the MIGraphX $MIGRAPHX_TAG
# requirements.txt (github.com/ROCm/AMDMIGraphX) plus the build provenance
# of the validated stack (see README.md, "Provenance").

# ONNX Runtime. v1.31.0 is the release that carries the MIGraphX EP.
: "${ORT_TAG:=v1.31.0}"
ORT_VERSION="${ORT_TAG#v}"

# MIGraphX release tag (and derived version), rocMLIR branch.
: "${MIGRAPHX_TAG:=rocm-$ROCM_VERSION}"
MIGRAPHX_VERSION="${MIGRAPHX_TAG#rocm-}"
: "${ROCKMLIR_BRANCH:=release/rocm-rel-$ROCM_VERSION}"

# composable_kernel commit (CK host / codegen JIT).
: "${CK_COMMIT:=ad0db05b040bacda751c65c705261b8a0a7ed25d}"

# --- Stage 01 source-build pins ------------------------------------------------------
# Built from source because no upstream Ubuntu/TheRock package provides the
# pinned version (checked 2026-10 against Ubuntu 26.10 / TheRock 10.1):
: "${ROCM_CMAKE_COMMIT:=6a7c5b73b8882c74f8f7060e2633f230dabb7b63}"  # TheRock ships no rocm-cmake
: "${ABSEIL_TAG:=20250512.0}"      # kept to mirror the validated deps prefix
: "${JSON_TAG:=v3.8.0}"            # system nlohmann-json3-dev is 3.12
: "${MSGPACK_TAG:=cpp-3.3.0}"      # Ubuntu has no msgpack package
: "${EIGEN_VERSION:=5.0.1}"        # Ubuntu's eigen is an older major
: "${PCRE_BRANCH:=8.45}"           # pcre1 (pfultz2 fork); Ubuntu only ships pcre2

# --- System (upstream deb) deps --------------------------------------------------------
# Used directly from the distribution, never built from source:
#   libzstd-dev, libsqlite3-dev — Ubuntu ships the pinned versions
#   libprotobuf-dev, protobuf-compiler — protobuf is used ONLY from the system.
#     MIGraphX's CMake does `find_package(protobuf QUIET CONFIG)` and, finding
#     nothing in the deps prefix, falls back to module mode, which resolves the
#     system protoc + shared libprotobuf. The validated stack links
#     libprotobuf.so.32 (Ubuntu libprotobuf32t64) dynamically. A protobuf
#     config in the deps prefix would make MIGraphX statically link its own
#     protobuf instead — a second protobuf runtime in the process alongside
#     ORT's bundled one, which breaks the MIGraphX EP at runtime.

# Minimum system protobuf version (validated against 3.21.12 on Ubuntu 26.10).
: "${MIN_PROTOBUF:=3.21}"

# --- 4. Toolchain -------------------------------------------------------------------

# ONNX Runtime stage compiler: system clang-22.
#   * GCC 15 trips -Werror=maybe-uninitialized false positives in
#     libstdc++ bits/unicode.h
#   * TheRock clang 24 trips -Werror,-Wdeprecated-attributes on the pinned
#     abseil/googletest/onnx/protobuf headers
: "${ORT_CC:=clang-22}"
: "${ORT_CXX:=clang++-22}"

: "${JOBS:=$(nproc)}"
: "${CCACHE_DIR:=$HOME/.cache/ccache}"

# --- 5. Paths (derived) -----------------------------------------------------------------
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# All build areas (sources, build trees, install prefixes).
: "${BUILD_ROOT:=$REPO_ROOT/build}"
DEPS_DIR="$BUILD_ROOT/deps"
DEPS_PREFIX="$DEPS_DIR/prefix"
ROCKMLIR_DIR="$BUILD_ROOT/rocmlir"
MIGRAPHX_DIR="$BUILD_ROOT/migraphx"
ORT_DIR="$BUILD_ROOT/ort"
STAMP_DIR="$BUILD_ROOT/stamps"

# Packaging
PACKAGE_ROOT="$REPO_ROOT/package"   # dpkg-deb payload tree (generated, gitignored)
DIST_DIR="$REPO_ROOT/dist"          # .deb output (generated, gitignored)

# --- 6. Packaging ----------------------------------------------------------------------
# Install location: /usr/lib/<multiarch>/<PKG_NAME>/. Per the Ubuntu
# packaging guide (ch. 10, "Shared Libraries"), shared libraries live in the
# /usr/lib/ tree (multi-arch: /usr/lib/x86_64-linux-gnu/ on amd64). The
# per-package subdirectory keeps per-GPU-target installs side by side (a flat
# layout is impossible: two target packages would own the same file names
# with different bytes) and, since ldconfig does not recurse into
# subdirectories, keeps the stack's libraries private to it.
: "${MULTIARCH:=x86_64-linux-gnu}"

# Package version = ORT version + revision. Bump PKG_REVISION whenever the
# packaging itself changes (control fields, maintainer scripts, layout).
#   rev 2: layout moved to /usr/lib/<multiarch>/<pkg>/ (guide ch. 10) and
#          unversioned dev symlinks dropped from the runtime package.
: "${PKG_REVISION:=2}"
PKG_VERSION="$ORT_VERSION-$PKG_REVISION"
: "${MAINTAINER:=kaerumy <kaerumy@users.noreply.github.com>}"

# Extra deb Depends entries (comma-separated), appended after the
# auto-derived ones. Leave empty unless you know why you need it.
: "${EXTRA_DEPENDS:=}"

# Explicit soname -> package rules (semicolon-separated "soname|family")
# that override the automatic detection in scripts/build-deb.sh. Family is
# one of:
#   runtime      -> amdrocm-runtime<ROCM_VERSION>
#   dnn          -> amdrocm-dnn<ROCM_VERSION>-<target>   (per GPU_TARGETS)
#   blas         -> amdrocm-blas<ROCM_VERSION>-<target>  (per GPU_TARGETS)
#   pkg:<name>   -> literal package name
: "${SONAME_RULES:=}"

set +a
